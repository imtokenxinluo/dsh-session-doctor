{
  "name": "dsh-session-doctor",
  "version": "0.2.2",
  "description": "Session doctor for DeepSeek Harness: scan stored session logs for load-blocking corruption (loader-mirror validation) and losslessly repair the supported shape drift (bare-string tool-result content → text blocks), with per-file backup. 会话体检与修复插件。",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./scan": {
      "default": "./src/scan.js"
    },
    "./repair": {
      "default": "./src/repair.js"
    },
    "./watch": {
      "default": "./src/watch.js"
    },
    "./plugin": {
      "default": "./src/plugin.js"
    },
    "./package.json": "./package.json",
    "./blame": {
      "default": "./src/blame.js"
    },
    "./safeguard": {
      "default": "./src/safeguard.js"
    }
  },
  "bin": {
    "dsh-session-doctor": "bin/dsh-session-doctor.js"
  },
  "files": [
    "src",
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SPEC.md",
    "docs/DEFECT-CATALOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test",
    "verify:real": "node scripts/verify-real.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "session",
    "corruption",
    "repair",
    "doctor"
  ]
}
